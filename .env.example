# App WhatsApp inbox (Hostinger subdominio)
# Copie como .env en esta carpeta (wa-inbox/)

PORT=7090
NODE_ENV=production

# Login fijo recepción
WA_USER=recepcion
WA_PASSWORD=CAMBIE_CLAVE_FUERTE
SESSION_SECRET=GENERAR_CON_CRYPTO_RANDOMBYTES_32_HEX
SESSION_COOKIE_SECURE=true
# Duración de sesión (días). Se guarda en MySQL (wa_sessions) y se renueva al usar la app.
SESSION_DAYS=30

# URL pública del subdominio (sin barra final)
FRONTEND_URL=https://wa.neurocienciasnarino.com
TWILIO_WEBHOOK_URL=https://wa.neurocienciasnarino.com/api/webhook

# MySQL (puede ser BD nueva o la misma de Innar; tablas wa_*)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=wa_inbox
DB_TIMEZONE=-05:00

# Twilio
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+19516251700
TWILIO_VALIDATE_SIGNATURE=true

# Apps Script (Sí/No → Sheet)
GAS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Botón Escríbenos
WHATSAPP_HUMANO_URL=https://wa.me/57XXXXXXXXXX

# Plantilla recordatorio (Content SID Approved)
# Variables: {{1}} paciente · {{2}} fecha · {{3}} hora · {{4}} profesional · {{5}} sede
TWILIO_CONTENT_SID=HXxxxx
WA_SEDE_DEFAULT=Sede Principal - San Ignacio

# Google Calendar (cuenta de servicio)
# 1) Google Cloud → crear Service Account → JSON key
# 2) Compartir CADA calendario (Angela, Karen…) con el client_email (permiso Ver eventos)
GOOGLE_CLIENT_EMAIL=wa-inbox@PROJECT.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Opcional: JSON mapa hoja→calendarId (si no, usa defaults del código)
# GOOGLE_CALENDARS_JSON={"Dra_Angela":"teresafisioterapia8@gmail.com","Dra_Karen":"karenfisioterapia956@gmail.com","Dra_Adriana":"fisioterapianeurociencias@gmail.com","Dra_Valentina":"psicologianeurociencias302@gmail.com"}

# Cron opcional (Hostinger, zona del servidor). Ej. 7:00 cada día:
# RECORDATORIO_CRON=0 7 * * *
